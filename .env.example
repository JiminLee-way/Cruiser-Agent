# Cruiser configuration example: copy to .env and fill in real values (.env is excluded by .gitignore; do not commit it)
DEEPSEEK_API_KEY=<DeepSeek key>
KIMI_API_KEY=<Kimi/Moonshot key, optional>
GLM_API_KEY=<Tencent TokenHub key, optional>
# Challenge definition file (default challenges.yaml in the project root; see challenges.example.yaml for a template)
# CRUISER_CHALLENGES=challenges.yaml
# CRUISER_WORKER_MODELS=deepseek-v4-flash,deepseek-v4-flash,deepseek-v4-pro,kimi-k3
