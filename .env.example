# Cruiser 配置示例：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，请勿提交）
DEEPSEEK_API_KEY=<DeepSeek 密钥>
KIMI_API_KEY=<Kimi/Moonshot 密钥，可选>
GLM_API_KEY=<腾讯 TokenHub 密钥，可选>
# 题目定义文件（默认项目根目录 challenges.yaml，模板见 challenges.example.yaml）
# CRUISER_CHALLENGES=challenges.yaml
